{
  "name": "obj3_step6",
  "description": "Objective 3, Step 6. Guided discovery on the shopping route. O3-S6 = O3-S5h + slots read from the whole conversation; with a concrete feature or two or more slots the harness runs one search (loosening filters that find nothing, and saying so) and the model recommends in one request; otherwise the kiosk asks a template question (no model call), at most twice. O3-S6m: the same, but the model phrases the question in one request. Single cases: the dev cases routed to shopping (eval/o3_shopping_dev_ids.json). Dialogues: 40 simulated dev customers with hidden profiles (eval/o3_dialogues.jsonl), for O3-S5h (model-driven shopping, the baseline), O3-S6 and O3-S6m. Greedy, Vulkan. About 2 hours; resumable.",
  "runs": [
    {
      "name": "o3s6_4b_rag_s6",
      "model": "Qwen3.5-4B",
      "quant": "Q4_K_M",
      "model_path": "models/qwen3.5-4b/Qwen3.5-4B-Q4_K_M.gguf",
      "backend": "vulkan",
      "server_exe": "llama-vulkan/llama-server.exe",
      "server_args": [
        "--jinja",
        "-c",
        "8192",
        "-np",
        "1",
        "-ngl",
        "99"
      ],
      "extra_server_args": [
        "--reasoning-budget",
        "0"
      ],
      "eval": "eval/rag_cases.jsonl",
      "split": "dev",
      "retrieval": "routed",
      "fallback": "gate",
      "context_view": "compact",
      "gate_style": "omit",
      "rag_rule": "rag_always_rule_b",
      "dedupe_shown": true,
      "warmup": true,
      "config_label": "O3-S6",
      "loop_guard": true,
      "tool_view": "compact",
      "harness_tools": true,
      "discovery": "template",
      "ids": "eval/o3_shopping_dev_ids.json"
