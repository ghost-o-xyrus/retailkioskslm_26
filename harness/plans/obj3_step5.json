{
  "name": "obj3_step5",
  "description": "Objective 3, Step 5. O3-S5 = O3-S4 + tools run by the harness + one-request store answers. For lookup, stock, compare and staff routes the harness reads the product code (or design name, colour, reason) from the message, runs the tool itself and shows it to the model as an earlier tool round; the model then writes the answer in one request with tool_choice none. Store questions are answered from the retrieved cards in one request; a service request gets call_staff(service) first, and an answer that says it does not know or offers staff gets a real call_staff(question_unanswered). Shopping, chat and unclear messages are unchanged (model-driven). O3-S5h = O3-S4 + harness tools only (ablation). Dev split, greedy, Vulkan, paired with the Step 4 O3-S4 runs. About 3 hours; resumable.",
  "runs": [
    {
      "name": "o3s5_4b_rag_s5",
      "model": "Qwen3.5-4B",
      "quant": "Q4_K_M",
      "model_path": "models/qwen3.5-4b/Qwen3.5-4B-Q4_K_M.gguf",
      "backend": "vulkan",
      "server_exe": "llama-vulkan/llama-server.exe",
      "server_args": [
        "--jinja",
        "-c",
        "8192",
        "-np",
        "1",
        "-ngl",
        "99"
      ],
      "extra_server_args": [
        "--reasoning-budget",
        "0"
      ],
      "eval": "eval/rag_cases.jsonl",
      "split": "dev",
      "retrieval": "routed",
      "fallback": "gate",
      "context_view": "compact",
      "gate_style": "omit",
      "rag_rule": "rag_always_rule_b",
      "dedupe_shown": true,
      "warmup": true,
      "config_label": "O3-S5",
      "loop_guard": true,
      "tool_view": "compact",
      "harness_tools": true,
      "store_one_round": true
