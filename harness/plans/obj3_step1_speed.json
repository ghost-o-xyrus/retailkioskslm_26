{
  "name": "obj3_step1_speed",
  "description": "Objective 3, Step 1. In-place timing of O3-B0 on the dev speed subset (40 retrieval questions + 30 tool cases, eval/o3_dev_speed_ids.json), 3 repeats each, repeats run as full passes so no case follows its own copy in the prompt cache. Tier A: Qwen3.5-2B Q8_0 on CPU, 4 threads. Tier B: Qwen3.5-4B Q4_K_M on Vulkan. Close other apps first. About 2 hours; resumable.",
  "runs": [
    {
      "name": "o3s1sp_a_2b_rag_b0",
      "model": "Qwen3.5-2B",
      "quant": "Q8_0",
      "model_path": "models/qwen3.5-2b/Qwen3.5-2B-Q8_0.gguf",
      "backend": "cpu",
      "server_exe": "llama-cpu/llama-server.exe",
      "server_args": [
        "--jinja",
        "-c",
        "8192",
        "-np",
        "1",
        "-ngl",
        "0",
        "-t",
        "4"
      ],
      "extra_server_args": [
        "--reasoning-budget",
        "0"
      ],
      "eval": "eval/rag_cases.jsonl",
      "split": "dev",
      "ids": "eval/o3_dev_speed_ids.json",
      "repeats": 3,
      "retrieval": "always",
      "fallback": "gate",
      "context_view": "compact",
      "gate_style": "omit",
      "rag_rule": "rag_always_rule_b",
      "dedupe_shown": true,
      "warmup": true,
      "config_label": "O3-B0"
    },
    {
      "name": "o3s1sp_a_2b_v11_b0",
      "model": "Qwen3.5-2B",
      "quant": "Q8_0",
      "model_path": "models/qwen3.5-2b/Qwen3.5-2B-Q8_0.gguf",
      "backend": "cpu",
      "server_exe": "llama-cpu/llama-server.exe",
      "server_args": [
        "--jinja",
        "-c",
        "8192",
        "-np",
        "1",
        "-ngl",
        "0",
        "-t",
        "4"
      ],
      "extra_server_args": [
        "--reasoning-budget",
        "0"
      ],
      "eval": "eval/eval_set_v1.1.jsonl",
      "split": "dev",
      "ids": "eval/o3_dev_speed_ids.json",
      "repeats": 3,
      "retrieval": "always",
      "fallback": "gate",
      "context_view": "compact",
      "gate_style": "omit",
      "rag_rule": "rag_always_rule_b",
      "dedupe_shown": true,
      "warmup": true,
      "config_label": "O3-B0"
    },
    {
      "name": "o3s1sp_b_4b_rag_b0",
      "model": "Qwen3.5-4B",
      "quant": "Q4_K_M",
      "model_path": "models/qwen3.5-4b/Qwen3.5-4B-Q4_K_M.gguf",
      "backend": "vulkan",
      "server_exe": "llama-vulkan/llama-server.exe",
      "server_args": [
        "--jinja",
        "-c",
        "8192",
        "-np",
        "1",
        "-ngl",
        "99"
      ],
      "extra_server_args": [
        "--reasoning-budget",
        "0"
      ],
      "eval": "eval/rag_cases.jsonl",
      "split": "dev",
      "ids": "eval/o3_dev_speed_ids.json",
      "repeats": 3,
      "retrieval": "always",
      "fallback": "gate",
      "context_view": "compact",
      "gate_style": "omit",
      "rag_rule": "rag_always_rule_b",
      "dedupe_shown": true,
      "warmup": true,
      "config_label": "O3-B0"
    },
    {
      "name": "o3s1sp_b_4b_v11_b0",
      "model": "Qwen3.5-4B",
      "quant": "Q4_K_M",
      "model_path": "models/qwen3.5-4b/Qwen3.5-4B-Q4_K_M.gguf",
      "backend": "vulkan",
      "server_exe": "llama-vulkan/llama-server.exe",
      "server_args": [
        "--jinja",
        "-c",
        "8192",
        "-np",
        "1",
        "-ngl",
        "99"
      ],
      "extra_server_args": [
        "--reasoning-budget",
        "0"
      ],
      "eval": "eval/eval_set_v1.1.jsonl",
      "split": "dev",
      "ids": "eval/o3_dev_speed_ids.json",
      "repeats": 3,
      "retrieval": "always",
      "fallback": "gate",
      "context_view": "compact",
      "gate_style": "omit",
