      "server_args": [
        "--jinja",
        "-c",
        "8192",
        "-np",
        "1",
        "-ngl",
        "0",
        "-t",
        "4"
      ],
      "extra_server_args": [
        "--reasoning-budget",
        "0"
      ],
      "split": "dev",
      "repeats": 1,
      "retrieval": "routed",
      "fallback": "gate",
      "context_view": "compact",
      "gate_style": "omit",
      "rag_rule": "rag_always_rule_b",
      "dedupe_shown": true,
      "warmup": true,
      "config_label": "O3-S6 dialogues",
      "loop_guard": true,
      "tool_view": "compact",
      "harness_tools": true,
      "dialogues": "eval/o3_dialogues.jsonl",
      "discovery": "template"
