        "0"
      ],
      "warmup": true,
      "eval": "eval/rag_cases.jsonl",
      "ids": "eval/rag_pilot_ids.json",
      "retrieval": "always",
      "fallback": "gate",
      "context_view": "compact",
      "gate_style": "omit",
      "rag_rule": "rag_always_rule_b"
    },
    {
