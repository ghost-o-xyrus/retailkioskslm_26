{
  "name": "obj3_step3",
  "description": "Objective 3, Step 3. O3-S3 = O3-S2 + loop guard + compact honest tool outputs. Loop guard: a repeated identical call and a second call_staff get a one-line note instead of running; the 4th (last) request is sent with tool_choice none so the turn ends in an answer; an empty final reply gets a fixed staff line (scored as empty). Compact view (tools/render.py): one line per watch, no marketing description, 'showing 3 of N', whether every search word matched, brands Veyra does not sell, 'not listed' for missing values; 3 search results by default; spec words (glass, material, movement...) matched only against spec fields. O3-S3g = O3-S2 + loop guard only (ablation). Dev split, greedy, Vulkan, paired with the Step 2 O3-S2 runs. About 3 hours; resumable.",
  "runs": [
    {
      "name": "o3s3_4b_rag_s3",
      "model": "Qwen3.5-4B",
      "quant": "Q4_K_M",
      "model_path": "models/qwen3.5-4b/Qwen3.5-4B-Q4_K_M.gguf",
      "backend": "vulkan",
      "server_exe": "llama-vulkan/llama-server.exe",
      "server_args": [
        "--jinja",
        "-c",
        "8192",
        "-np",
        "1",
        "-ngl",
        "99"
      ],
      "extra_server_args": [
        "--reasoning-budget",
        "0"
      ],
      "eval": "eval/rag_cases.jsonl",
      "split": "dev",
      "retrieval": "always",
      "fallback": "gate",
      "context_view": "compact",
      "gate_style": "omit",
      "rag_rule": "rag_always_rule_b",
      "dedupe_shown": true,
      "warmup": true,
      "config_label": "O3-S3",
      "loop_guard": true,
      "tool_view": "compact"
