{
  "name": "stage4_speed",
  "description": "Speed and RAM on the fixed 30-case subset, every finalist x quant x backend. Use --only to select the finalists' entries. CPU runs use 4 threads (Tier A); Vulkan runs offload all layers (Tier B). Check model_path values against your models/ folder; filenames follow model_registry.csv.",
  "base_dir": "..",
  "defaults": {
    "port": 8080,
    "eval": "eval/eval_set.jsonl",
    "ids": "eval/speed_subset_ids.json",
    "set": "all",
    "split": "all",
    "repeats": 1,
    "temperature": 0
  },
  "runs": [
