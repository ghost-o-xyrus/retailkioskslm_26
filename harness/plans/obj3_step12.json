{
  "name": "obj3_step12",
  "description": "Objective 3, Step 12 end-to-end check: O3-S12 = O3-S11b with the retrieval configuration chosen by retrieval\\bench_speed.py and the thresholds re-derived for it by retrieval\\calibrate_step9.py. Dev store questions, v1.2 tool cases and follow-ups, both models, Vulkan. About 1.5-2 hours, resumable.",
  "runs": [
    {
      "name": "o3s12_4b_rag",
      "model": "Qwen3.5-4B",
      "quant": "Q4_K_M",
      "model_path": "models/qwen3.5-4b/Qwen3.5-4B-Q4_K_M.gguf",
      "backend": "vulkan",
      "server_exe": "llama-vulkan/llama-server.exe",
      "server_args": [
        "--jinja",
        "-c",
        "8192",
        "-np",
        "1",
        "-ngl",
        "99"
      ],
      "extra_server_args": [
        "--reasoning-budget",
        "0"
      ],
      "eval": "eval/rag_cases.jsonl",
      "split": "dev",
      "retrieval": "routed",
      "fallback": "store-live",
      "context_view": "compact",
      "gate_style": "omit",
      "rag_rule": "rag_always_rule_b",
      "dedupe_shown": true,
      "warmup": true,
      "config_label": "O3-S12",
      "loop_guard": true,
      "tool_view": "compact",
      "harness_tools": true,
      "discovery": "template",
      "forced_answer": "recover",
