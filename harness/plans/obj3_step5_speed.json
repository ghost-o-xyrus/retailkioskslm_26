{
  "name": "obj3_step5_speed",
  "description": "Objective 3, Step 5. Tier A in-place timing of O3-S5: Qwen3.5-2B Q8_0 on CPU, 4 threads, the 70-case dev speed subset, 1 repeat. Compared with the Step 4 O3-S4 timing runs. Close other apps. About 15-25 minutes.",
  "runs": [
    {
      "name": "o3s5sp_a_2b_rag_s5",
      "model": "Qwen3.5-2B",
      "quant": "Q8_0",
      "model_path": "models/qwen3.5-2b/Qwen3.5-2B-Q8_0.gguf",
      "backend": "cpu",
      "server_exe": "llama-cpu/llama-server.exe",
      "server_args": [
        "--jinja",
        "-c",
        "8192",
        "-np",
        "1",
        "-ngl",
        "0",
        "-t",
        "4"
      ],
      "extra_server_args": [
        "--reasoning-budget",
        "0"
      ],
      "eval": "eval/rag_cases.jsonl",
      "split": "dev",
      "ids": "eval/o3_dev_speed_ids.json",
      "repeats": 1,
      "retrieval": "routed",
      "fallback": "gate",
      "context_view": "compact",
      "gate_style": "omit",
      "rag_rule": "rag_always_rule_b",
      "dedupe_shown": true,
      "warmup": true,
      "config_label": "O3-S5",
      "loop_guard": true,
      "tool_view": "compact",
      "harness_tools": true,
      "store_one_round": true
    },
    {
      "name": "o3s5sp_a_2b_v12_s5",
      "model": "Qwen3.5-2B",
      "quant": "Q8_0",
      "model_path": "models/qwen3.5-2b/Qwen3.5-2B-Q8_0.gguf",
      "backend": "cpu",
      "server_exe": "llama-cpu/llama-server.exe",
      "server_args": [
        "--jinja",
        "-c",
        "8192",
        "-np",
        "1",
        "-ngl",
        "0",
        "-t",
        "4"
      ],
      "extra_server_args": [
        "--reasoning-budget",
        "0"
      ],
      "eval": "eval/eval_set_v1.2.jsonl",
      "split": "dev",
      "ids": "eval/o3_dev_speed_ids.json",
      "repeats": 1,
      "retrieval": "routed",
      "fallback": "gate",
      "context_view": "compact",
      "gate_style": "omit",
      "rag_rule": "rag_always_rule_b",
      "dedupe_shown": true,
      "warmup": true,
      "config_label": "O3-S5",
      "loop_guard": true,
      "tool_view": "compact",
      "harness_tools": true,
      "store_one_round": true
    }
  ],
  "base_dir": "..",
  "results_dir": "results_obj3",
  "defaults": {
    "port": 8080,
    "set": "all",
    "temperature": 0
  }
}