{
 "name": "obj3_step15_r1_4b_rag",
 "description": "Objective 3, Step 15 ladder on O3-T, Kaggle CPU: R1: + tool output v2, loop guard (Tier B), o3l_r1_4b_rag.",
 "base_dir": "..",
 "results_dir": "results_obj3",
 "kaggle_max_minutes": 650,
 "kaggle_llama_build": "fixed",
 "kaggle_llama_tag": "b12110",
 "defaults": {
  "port": 8080,
  "set": "all",
  "repeats": 1,
  "temperature": 0
 },
 "runs": [
  {
   "model": "Qwen3.5-4B",
   "quant": "Q4_K_M",
   "model_path": "models/qwen3.5-4b/Qwen3.5-4B-Q4_K_M.gguf",
   "eval": "eval/rag_cases_o3t.jsonl",
   "split": "test",
   "backend": "cpu",
   "server_exe": "llama-cpu/llama-server.exe",
   "server_args": [
    "--jinja",
    "-c",
    "8192",
    "-np",
    "1",
    "-ngl",
    "0",
    "-t",
    "4"
   ],
   "extra_server_args": [
    "--reasoning-budget",
    "0"
   ],
   "name": "o3l_r1_4b_rag",
   "config_label": "R1: + tool output v2, loop guard (Tier B)",
   "retrieval": "always",
   "fallback": "gate",
   "context_view": "compact",
   "gate_style": "omit",
   "rag_rule": "rag_always_rule_b",
