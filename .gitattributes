# Windows command scripts must keep Windows line endings, or cmd.exe misreads them
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Data and results are stored exactly as generated or measured
*.csv -text
*.jsonl -text
*.json -text
*.log -text
*.pdf binary
*.pptx binary
*.png binary
*.jpg binary
*.svg -text
