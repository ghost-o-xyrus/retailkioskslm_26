   "reranker_choice": "results_obj3/_speed_step12/choice.json",
   "answer_length": false,
   "parallel_tools": true,
   "data_dir": "data_train/kiosk",
   "corpus": "finetune/knowledge/corpus.jsonl",
   "server_cmd": [
