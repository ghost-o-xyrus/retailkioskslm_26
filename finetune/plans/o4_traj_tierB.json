   "context_view": "focused",
   "gate_style": "omit",
   "rag_rule": "rag_always_rule_b",
   "dedupe_shown": true,
   "warmup": false,
   "config_label": "O3-final (Tier B) + oracle",
   "loop_guard": true,
   "tool_view": "compact",
