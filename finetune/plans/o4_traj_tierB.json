{
 "name": "o4_traj_tierB",
 "description": "Objective 4, Step 2: run the training questions through the real harness with O3-final's Tier B settings, on the training catalogue (data_train, finetune/knowledge/corpus.jsonl), against the oracle (finetune/oracle_server.py) instead of a model. Each request the harness sends, and the oracle's correct answer, is logged to results_o4/traj_b/. No model, no GPU; retrieval runs as deployed. About 20-40 minutes.",
 "base_dir": "..",
 "results_dir": "results_o4",
 "defaults": {
  "port": 8080,
  "set": "all",
  "repeats": 1,
  "temperature": 0
 },
 "runs": [
  {
   "name": "o4traj_b_tools",
   "model": "Qwen3.5-4B",
   "quant": "Q4_K_M",
   "model_path": "models/qwen3.5-4b/Qwen3.5-4B-Q4_K_M.gguf",
   "backend": "vulkan",
   "server_exe": "llama-vulkan/llama-server.exe",
   "server_args": [
    "--jinja",
    "-c",
    "8192",
    "-np",
    "1",
    "-ngl",
    "99"
   ],
   "extra_server_args": [
    "--reasoning-budget",
    "0"
   ],
   "eval": "finetune/train/tools.jsonl",
   "split": "train",
   "retrieval": "routed",
   "fallback": "store-live",
   "context_view": "focused",
   "gate_style": "omit",
   "rag_rule": "rag_always_rule_b",
   "dedupe_shown": true,
   "warmup": false,
   "config_label": "O3-final (Tier B) + oracle",
   "loop_guard": true,
   "tool_view": "compact",
   "harness_tools": true,
   "discovery": "template",
   "forced_answer": "recover",
   "entity_check": true,
   "fallback_config": "results_obj3/_speed_step12/fallback.json",
   "staff_check": true,
   "verify_answers": "shown",
   "followup_retrieval": true,
   "focus_memory": true,
   "reranker_choice": "results_obj3/_speed_step12/choice.json",
   "answer_length": false,
   "parallel_tools": true,
   "data_dir": "data_train/kiosk",
   "corpus": "finetune/knowledge/corpus.jsonl",
   "server_cmd": [
    "python",
    "finetune/oracle_server.py",
    "--cases",
    "finetune/train/tools.jsonl",
    "--log",
    "results_o4/traj_b/tools.jsonl"
   ],
   "load_timeout": 60
  },
  {
   "name": "o4traj_b_store",
   "model": "Qwen3.5-4B",
   "quant": "Q4_K_M",
   "model_path": "models/qwen3.5-4b/Qwen3.5-4B-Q4_K_M.gguf",
